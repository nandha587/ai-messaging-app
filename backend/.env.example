# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Gemini API (For Smart Replies - Get from aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Firebase Admin (download serviceAccountKey.json from Firebase Console)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Message Encryption
ENCRYPTION_KEY=32-char-hex-key-for-aes-256-encryption
